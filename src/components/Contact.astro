---
import TriBar from "./TriBar.astro";

const info = [
  {
    label: "Teléfono / WhatsApp",
    value: "+52 871 519 5688",
    href: "https://wa.me/528715195688?text=Quiero%20informaci%C3%B3n%20sobre%20sus%20consultas%20psicol%C3%B3gicas",
    external: true,
  },
  { label: "Correo", value: "psic.alp@gmail.com", href: "mailto:psic.alp@gmail.com" },
  {
    label: "Consultorio",
    value: "Blvd. Miguel Alemán 871, Valle del Campestre, CP 35080, Gómez Palacio, Durango",
    href: "https://maps.app.goo.gl/N4iZrzgRAAFgmqEA6",
    external: true,
  },
];
---

<section id="contacto" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
  <div class="grid gap-12 rounded-[2rem] border-2 border-tinta/10 bg-papel p-8 shadow-sm sm:p-12 lg:grid-cols-2 lg:gap-16" data-reveal>
    <div>
      <TriBar />
      <h2 class="mt-4 font-display text-3xl leading-tight text-balance text-tinta sm:text-4xl">
        ¿Listos para dar el primer paso?
      </h2>
      <ul class="mt-8 space-y-4">
        {
          info.map((item) => (
            <li>
              <p class="text-xs font-semibold text-tinta-suave">{item.label}</p>
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="text-base font-semibold text-tinta transition-colors hover:text-rosa-500"
              >
                {item.value}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="min-h-[320px] overflow-hidden rounded-2xl border-2 border-tinta/10">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3599.5022054961814!2d-103.50499932478809!3d25.554953477482325!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x868fd9ac2dd42015%3A0x1b3236e82f16f542!2sPsic%C3%B3loga%20Anarely%20Padilla!5e0!3m2!1ses!2smx!4v1784396949985!5m2!1ses!2smx"
        class="h-full min-h-[320px] w-full"
        style="border:0;"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        title="Ubicación del consultorio de Anarely Padilla"
      ></iframe>
    </div>
  </div>
</section>
