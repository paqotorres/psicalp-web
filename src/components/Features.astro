---
import TriBar from "./TriBar.astro";

const features = [
  {
    icon: "smile",
    title: "Terapia Infantil",
    text: "Un espacio de juego y palabra donde niñas y niños aprenden a nombrar lo que sienten y a construir herramientas emocionales para su día a día.",
    chip: "bg-rosa-100 text-rosa-600",
  },
  {
    icon: "bond",
    title: "Terapia Vincular",
    text: "Trabajamos en conjunto con padres e hijos para fortalecer el vínculo afectivo, mejorar la comunicación y sanar las dinámicas que generan conflicto en casa.",
    chip: "bg-azul-100 text-azul-600",
  },
  {
    icon: "compass",
    title: "Terapia a Adolescentes",
    text: "Acompaño a adolescentes en la búsqueda de su identidad y el manejo de la ansiedad y las presiones sociales, desde un espacio de escucha sin juicios.",
    chip: "bg-amarillo-100 text-amarillo-600",
  },
  {
    icon: "cap",
    title: "Tests Vocacionales",
    text: "Evaluaciones que ayudan a adolescentes a descubrir sus intereses y habilidades, y a orientar con mayor claridad su siguiente paso académico o profesional.",
    chip: "bg-rosa-100 text-rosa-600",
  },
];

const icons: Record<string, string> = {
  smile:
    '<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="15" cy="10" r="1" fill="currentColor"/><path d="M8.5 14c1 1.2 2.2 1.8 3.5 1.8s2.5-.6 3.5-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  bond:
    '<circle cx="9" cy="12" r="6" stroke="currentColor" stroke-width="1.5"/><circle cx="15" cy="12" r="6" stroke="currentColor" stroke-width="1.5"/>',
  compass:
    '<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><path d="M15 9l-2 5-5 2 2-5 5-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>',
  cap:
    '<path d="M12 4 2 9l10 5 10-5-10-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 11.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section id="servicios" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
  <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16" data-reveal>
    <div>
      <TriBar />
      <h2 class="mt-4 font-display text-3xl leading-tight text-balance text-tinta sm:text-4xl">
        Servicios que ofrezco
      </h2>
    </div>
    <p class="self-end text-base leading-relaxed text-tinta-suave">
      Cada servicio está pensado para acompañar una etapa distinta del desarrollo de tu
      hijo o hija, siempre con un enfoque cálido y basado en evidencia.
    </p>
  </div>

  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      features.map((feature, i) => (
        <div
          class="rounded-2xl border-2 border-tinta/10 bg-papel p-6 transition-all duration-300 hover:-translate-y-1 hover:border-tinta/20 hover:shadow-lg"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <span class:list={["flex h-11 w-11 items-center justify-center rounded-xl", feature.chip]}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" set:html={icons[feature.icon]} />
          </span>
          <h3 class="mt-4 font-display text-lg font-semibold text-tinta">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-tinta-suave">{feature.text}</p>
        </div>
      ))
    }
  </div>
</section>
