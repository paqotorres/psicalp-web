---
const columns = [
  {
    title: "Navegación",
    links: [
      { label: "Inicio", href: "/#inicio" },
      { label: "Sobre Mí", href: "/#sobre-mi" },
      { label: "Servicios", href: "/#servicios" },
      { label: "Agenda tu Cita", href: "/#agenda" },
    ],
  },
  {
    title: "Recursos",
    links: [
      { label: "Preguntas Frecuentes", href: "/#preguntas-frecuentes" },
      { label: "Política de Cancelación", href: "/#politica-cancelacion" },
      { label: "Contacto", href: "/#contacto" },
    ],
  },
];

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-tinta/10 bg-papel-100">
  <div class="mx-auto max-w-7xl px-6 py-14 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_0.8fr_0.8fr]">
      <div>
        <a href="/#inicio" class="flex items-center gap-3">
          <img src="/logo-alp-mark.png" alt="PSIC ALP" class="h-11 w-auto" />
          <span class="font-display text-base font-semibold text-tinta">Anarely Padilla</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-tinta-suave">
          Psicóloga infantil y de adolescentes. Acompañamiento cálido y profesional para que
          cada niño crezca con confianza.
        </p>
        <div class="mt-5 flex gap-3">
          <a
            href="https://instagram.com/psic.alp"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-tinta/15 text-tinta-suave transition-colors hover:border-rosa-400 hover:text-rosa-500"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" />
            </svg>
          </a>
          <a
            href="https://www.facebook.com/Psic.Alp/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-tinta/15 text-tinta-suave transition-colors hover:border-azul-400 hover:text-azul-500"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 9h2.5V6H14c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v6h3v-6H16l.5-3h-3V9.8c0-.5.2-.8.9-.8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            </svg>
          </a>
          <a
            href="https://wa.me/528715195688?text=Quiero%20informaci%C3%B3n%20sobre%20sus%20consultas%20psicol%C3%B3gicas"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-tinta/15 text-tinta-suave transition-colors hover:border-amarillo-400 hover:text-amarillo-600"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 3a9 9 0 0 0-7.6 13.8L3 21l4.4-1.3A9 9 0 1 0 12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              <path d="M8.5 8.7c.2-.5.5-.5.8-.5h.6c.2 0 .4 0 .6.5.2.5.7 1.7.7 1.9.1.1.1.3 0 .4-.1.2-.2.3-.3.4-.1.1-.3.3-.4.4-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1 .2-.2.3-.2.6-.1.2.1 1.5.7 1.8.8.3.1.5.2.5.3 0 .2 0 .9-.4 1.4-.3.5-1.5.9-2.1.9-.5.1-1.2.1-4-1.1-3.3-1.5-5.4-4.9-5.5-5.1-.2-.2-1.3-1.7-1.3-3.3 0-1.6.8-2.3 1.1-2.6Z" fill="currentColor" />
            </svg>
          </a>
        </div>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="font-display text-sm font-bold text-tinta">{col.title}</p>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-tinta-suave hover:text-tinta">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 border-t border-tinta/10 pt-6 text-xs text-tinta-suave">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>© {currentYear} Anarely Padilla · Psicóloga Infantil. Todos los derechos reservados.</p>
        <p>
          <a href="/aviso-de-privacidad" class="hover:text-tinta">Aviso de privacidad</a>
          {" · "}
          <a href="/terminos-de-servicio" class="hover:text-tinta">Términos de servicio</a>
        </p>
      </div>
      <p class="mt-2">Cédula profesional (Licenciatura) 12200201 · Cédula profesional (Maestría) 15293450</p>
    </div>
  </div>
</footer>
