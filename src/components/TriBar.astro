---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["flex h-2 w-14 overflow-hidden rounded-full", className]} aria-hidden="true">
  <span class="w-1/3 bg-rosa-400"></span>
  <span class="w-1/3 bg-azul-400"></span>
  <span class="w-1/3 bg-amarillo-400"></span>
</div>
