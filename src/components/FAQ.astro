---
import TriBar from "./TriBar.astro";

const faqs = [
  {
    q: "¿Qué pasa si mi hijo no quiere ir a terapia?",
    a: "No es necesario que llegue convencido. Parte de las primeras sesiones consiste en construir un vínculo de confianza para que se sienta seguro de participar a su propio ritmo.",
  },
  {
    q: "¿Los padres participan en las sesiones?",
    a: "La primera consulta siempre es con los padres o un adulto responsable, ya que se realiza una entrevista para conocer más sobre el motivo de consulta. A partir de ahí, depende de la edad y del motivo: en general trabajo directamente con el niño o adolescente y mantengo reuniones periódicas de seguimiento con los padres.",
  },
  {
    q: "¿Cuánto dura el proceso terapéutico?",
    a: "Varía según cada caso. Algunos procesos son breves y puntuales, otros requieren un acompañamiento más largo. Esto se revisa juntos después de las primeras sesiones.",
  },
  {
    q: "¿Cómo sé si mi hijo necesita apoyo psicológico?",
    a: "Cambios bruscos de conducta, dificultades para dormir, ansiedad frecuente o problemas escolares pueden ser señales.",
  },
];

const dots = ["bg-rosa-400", "bg-azul-400", "bg-amarillo-400", "bg-rosa-400"];
---

<section id="preguntas-frecuentes" class="bg-papel py-20">
  <div class="mx-auto max-w-3xl px-6 lg:px-8">
    <div class="text-center" data-reveal>
      <TriBar class="mx-auto" />
      <h2 class="mt-4 font-display text-3xl leading-tight text-balance text-tinta sm:text-4xl">
        Resolvemos tus dudas
      </h2>
    </div>

    <div class="mt-10 divide-y divide-tinta/10 rounded-2xl border-2 border-tinta/10 bg-papel">
      {
        faqs.map((item, i) => (
          <details class="group px-6 py-5" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-medium text-tinta">
              <span class="flex items-center gap-3">
                <span class:list={["h-2 w-2 shrink-0 rounded-full", dots[i % dots.length]]} />
                {item.q}
              </span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="shrink-0 text-tinta transition-transform group-open:rotate-45"
              >
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="mt-3 pl-5 text-sm leading-relaxed text-tinta-suave">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
