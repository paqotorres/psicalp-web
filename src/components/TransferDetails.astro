---
import TriBar from "./TriBar.astro";
---

<section id="transferencia" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <TriBar class="mx-auto" />
    <h2 class="mt-4 font-display text-3xl leading-tight text-balance text-tinta sm:text-4xl">
      Datos para Transferencia
    </h2>
    <p class="mt-4 text-base leading-relaxed text-tinta-suave">
      Si prefieres cubrir el depósito o el resto de tu sesión por transferencia, estos son los
      datos.
    </p>
  </div>

  <div
    class="mx-auto mt-10 max-w-md rounded-3xl bg-rosa-500 p-8 text-papel shadow-xl sm:p-10"
    data-reveal
    style="--reveal-delay: 80ms"
  >
    <p class="font-display text-2xl font-bold tracking-wide" id="transfer-number">4152 3138 2741 9529</p>
    <p class="mt-3 text-sm text-papel/90">BBVA</p>
    <p class="text-sm text-papel/90">Anarely López Padilla</p>

    <button
      type="button"
      id="transfer-copy"
      class="mt-6 flex w-full items-center justify-center gap-2 rounded-full border-2 border-papel/40 px-5 py-2.5 text-sm font-semibold text-papel transition-colors hover:bg-papel hover:text-rosa-600"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.8" />
        <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.8" />
      </svg>
      Copiar número
    </button>
  </div>

  <p class="mx-auto mt-6 max-w-md text-center text-sm text-tinta-suave" data-reveal style="--reveal-delay: 140ms">
    Al momento de hacer la transferencia,{" "}
    <span class="font-semibold text-tinta">coloca en el concepto el nombre del paciente</span>.
  </p>
</section>

<script>
  const copyBtn = document.getElementById("transfer-copy") as HTMLButtonElement;
  const number = document.getElementById("transfer-number")!;

  copyBtn.addEventListener("click", async () => {
    const text = number.textContent?.replace(/\s+/g, "") ?? "";
    try {
      await navigator.clipboard.writeText(text);
      const original = copyBtn.textContent;
      copyBtn.textContent = "¡Copiado!";
      setTimeout(() => {
        copyBtn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.8" />
            <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" stroke="currentColor" stroke-width="1.8" />
          </svg>
          Copiar número
        `;
      }, 1800);
    } catch {
      // Clipboard API unavailable; the number is already visible to copy manually.
    }
  });
</script>
